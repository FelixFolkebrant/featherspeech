# Copy to .env. Keep this file local; .env is ignored by git.
OPENROUTER_API_KEY=
VC_MODEL=openai/gpt-6-luna
# Conversation history, response cap and idle timeout are configured in config.toml.
# Switch backend, then restart the voice assistant service. Both run locally on the CPU.
VC_TTS_BACKEND=pocket
VC_TTS_THREADS=4
# Pocket settings (preserved when switching to Kitten):
VC_VOICE=alba
# January model selects the original 100M model, not the newer small variants.
VC_TTS_LANGUAGE=english_2026-01
# Kitten 0.8 settings: nano (15M), micro (40M), mini (80M).
VC_KITTEN_MODEL=mini
VC_KITTEN_VOICE=Jasper
VC_KITTEN_SPEED=1.0

# Shared room: persistent history/memory/tasks (use :memory: for no disk persistence).
VC_ROOM_DB=run/room.sqlite
VC_DEEP_MODEL=openai/gpt-6.1-terra
VC_CODEX_CHAT_MODEL=openai/gpt-6-luna
# Operator-selected coding workspace; never selected by a model.
VC_CODEX_PROJECT=.
VC_CODEX_BIN=codex
# App Server supports approvals and questions through the room; exec is a compatibility option.
VC_CODEX_BACKEND=app-server
# Full access is explicit: say give Codex full access for this session, or set full here.
VC_CODEX_ACCESS=sandboxed
VC_CODEX_ALLOW_EXECUTE=true
# VC_CODEX_MODEL=  # optional CLI model override
VC_TASK_CONCURRENCY=2
VC_TASK_LIMIT=8
VC_TASK_TIMEOUT_SECS=600
VC_RUN_MAX_USD=0.25
# Optional Deep Think web search. Without it, no web-search tool is offered.
# BRAVE_SEARCH_API_KEY=

# Optional TUI control socket (defaults to agent socket without .sock + .control.sock).
# VC_CONTROL_SOCKET=/absolute/path/to/run/agent.control.sock
# Direct backend startup without audio (scripts/vc tui sets this automatically).
# VC_TEXT_ONLY=1
# Open the terminal companion when an agent presents an artifact and no client is attached.
# VC_TUI_AUTO_OPEN=1
# Optional preferred terminal: kitty, alacritty, wezterm, ghostty, gnome-terminal,
# konsole, x-terminal-emulator, or xterm. Otherwise the first installed one is used.
# VC_TUI_TERMINAL=kitty
